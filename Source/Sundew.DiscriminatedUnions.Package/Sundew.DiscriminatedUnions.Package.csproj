<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;net8.0;netstandard2.0</TargetFrameworks>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- Microsoft.SourceLink.GitHub brings in System.IO.Hashing 11.0.0, which warns that it does not support net8.0. Only the SourceLink build task uses it and nothing of it ends up in the package. -->
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Sundew.DiscriminatedUnions</PackageId>
    <PackageReadmeFile>docs/README.md</PackageReadmeFile>
    <PackageIconUrl>http://ICON_URL_HERE_OR_DELETE_THIS_LINE</PackageIconUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>Sundew.DiscriminatedUnions, analyzers</PackageTags>
    <Description>Sundew.DiscriminatedUnions generates allocation free struct unions for C# 15, which the compiler matches exhaustively like union declarations but without boxing cases that are structs.
It also implements discriminated unions for class hierarchies and enums with exhaustive switch expressions and statements.
    </Description>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzersToOutput</TargetsForTfmSpecificContentInPackage>
    <PackageReleaseNotes>
7.0 - Major overhaul to support C# 15 union types. Requires the C# 15 compiler (.NET 11 SDK, Roslyn 5.12). See readme for details.
6.0 - Cases now required to be partial.
5.4 - Support IDiscriminatedUnion for enumerating cases.
2.0 - Support matching unions in referenced projects, marker attributes included as source rather than library reference.
1.0 - Initial version
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedFiles Include="$(GeneratedAssemblyInfoFile)" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\docs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sundew.DiscriminatedUnions\Sundew.DiscriminatedUnions.csproj" />
    <ProjectReference Include="..\Sundew.DiscriminatedUnions.CodeFixes\Sundew.DiscriminatedUnions.CodeFixes.csproj" />
    <ProjectReference Include="..\Sundew.DiscriminatedUnions.Analyzer\Sundew.DiscriminatedUnions.Analyzer.csproj" />
    <ProjectReference Include="..\Sundew.DiscriminatedUnions.Generator\Sundew.DiscriminatedUnions.Generator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tools\*.ps1" CopyToOutputDirectory="Always" Pack="true" PackagePath="" />
    <None Include="$(BaseOutputPath)\$(Configuration)\netstandard2.0\Sundew.DiscriminatedUnions.Analyzer.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="$(BaseOutputPath)\$(Configuration)\netstandard2.0\Sundew.DiscriminatedUnions.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
    <None Include="$(BaseOutputPath)\$(Configuration)\netstandard2.0\Sundew.DiscriminatedUnions.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" />
  </ItemGroup>

  <Target Name="_AddAnalyzersToOutput">
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(OutputPath)\Sundew.DiscriminatedUnions.dll" PackagePath="lib\$(TargetFramework)" />
    </ItemGroup>
  </Target>

</Project>




