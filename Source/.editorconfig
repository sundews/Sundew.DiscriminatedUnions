root = true

[*.csproj]
tab_width = 2
indent_size = 2
end_of_line = crlf

[*.{cs,vb}]
csharp_using_directive_placement = inside_namespace:error
csharp_style_namespace_declarations = file_scoped:error
dotnet_style_readonly_field = true:error

dotnet_sort_system_directives_first = true

[**TestData/**/*.cs]
dotnet_diagnostic.CS1591.severity = none  # Don't require XML comments in test projects

[Sundew.DiscriminatedUnions.Development.{TestData,Tester}/**.cs]
# These projects keep a union and its cases in one file (SA1402 is off for them), so SA1649 names a file after its first type of any kind and not after its first class.
stylecop.maintainability.topLevelTypes = class, interface, struct, enum, delegate

[Sundew.Base/**.cs]
# These files belong to the Sundew.Base submodule and are compiled into the generator. Several of its partial types carry a summary on every part, which SA1653 reports.
# The submodule is checked in its own repository, so the rule is not applied to its files here.
dotnet_diagnostic.SA1653.severity = none
